# CS-RAG v2 后端配置模板
CS_RAG_DEPLOYMENT_MODE=local
CS_RAG_HOST=127.0.0.1
CS_RAG_PORT=8000
CS_RAG_DATA_ROOT=data
# 算法目录；相对路径以 system 目录为基准，不是当前终端目录。
CS_RAG_REFERENCE_ROOT=..
CS_RAG_MODELS_ROOT=models

# 模型服务：填写 OpenAI-compatible 服务地址和 Key
CS_RAG_MODEL_BASE_URL=
CS_RAG_MODEL_API_KEY=
CS_RAG_MODEL_NAME=gpt-4o-mini
CS_RAG_MODEL_TIMEOUT_SECONDS=90
CS_RAG_EMBEDDING_BASE_URL=
CS_RAG_EMBEDDING_API_KEY=
CS_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CS_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 向量存储：local_file 不依赖额外服务；qdrant 需要项目环境中的 qdrant-client
CS_RAG_VECTOR_STORE_BACKEND=local_file
CS_RAG_VECTOR_STORE_ROOT=data/vector_store
CS_RAG_QDRANT_URL=
CS_RAG_QDRANT_API_KEY=
CS_RAG_QDRANT_COLLECTION_PREFIX=csrag
CS_RAG_QDRANT_ON_DISK=true
CS_RAG_TEXT_INDEX_BATCH_SIZE=32

# 构建参数：也可在前端“设置”页调整并持久化
CS_RAG_CHUNK_MAX_TOKENS=512
CS_RAG_CHUNK_MIN_TOKENS=80
CS_RAG_CHUNK_PARENT_MAX_TOKENS=1536
CS_RAG_CHUNK_INCLUDE_HEADING=true
CS_RAG_CHUNK_SEMANTIC_BREAKPOINT_PERCENTILE=85
CS_RAG_CHUNK_TOKENIZER_MODEL=
CS_RAG_CHUNK_EMBEDDING_DEVICE=cpu
